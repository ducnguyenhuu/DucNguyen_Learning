variable "github_owner" {
  description = "GitHub account that owns the repository."
  type        = string
  default     = "ducnguyenhuu"
}

variable "repository" {
  description = "Repository name (without the owner)."
  type        = string
  default     = "delivery-intelligent-platform"
}

variable "production_reviewer" {
  description = "GitHub login of the single required reviewer for the production environment."
  type        = string
  default     = "ducnguyenhuu"
}

variable "pipeline_variables" {
  description = "The repository variables the pipeline reads (specs/006-ci-cd/contracts/pipeline.md → Inputs). Identifiers and hostnames only — never a secret. Generated by infrastructure/scripts/pipeline-variables.sh."
  type        = map(string)

  validation {
    condition = alltrue([for k in [
      "AZURE_TENANT_ID", "AZURE_SUBSCRIPTION_ID", "AZURE_DEPLOYER_CLIENT_ID", "AZURE_LOADTEST_CLIENT_ID",
      "TENANCY_API_APP_ID_URI", "ACR_LOGIN_SERVER", "RESOURCE_GROUP", "CONTAINER_APP_NAME", "FRONTDOOR_ENDPOINT",
    ] : contains(keys(var.pipeline_variables), k)])
    error_message = "pipeline_variables must define all nine variables listed in contracts/pipeline.md."
  }
}

variable "required_checks" {
  description = "Job names of the gate jobs in .github/workflows/pipeline.yml; renaming a job there means changing this list."
  type        = list(string)
  default     = ["commit-messages", "secret-scan", "build-test", "integration-test", "container-scan"]
}
