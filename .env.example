# Copy to .env and fill in every value. No default lives here on purpose —
# see specs/004-containerization/contracts/compose-stack.md for the required-variable contract.

# SQL Server sa password. Must be >= 8 characters from three of the four character
# classes (upper, lower, digit, symbol) or the sqlserver container exits at startup.
MSSQL_SA_PASSWORD=

# Entra ID (Azure AD) app registration values — same values used by the dotnet run /
# User Secrets workflow. Required for authenticated tenant operations.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

# OTel Collector tail-sampling rate for non-error traces (percent). Optional — defaults to 10.
SAMPLE_RATE=
