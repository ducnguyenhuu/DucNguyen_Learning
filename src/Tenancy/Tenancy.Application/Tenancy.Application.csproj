<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tenancy.Domain\Tenancy.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only for the DbUpdateException type used by EnsureUserProvisioned's get-or-create race
         handling (T036) — this project still has no dependency on TenancyDbContext, DbContext,
         or any provider-specific (e.g. SqlServer) EF Core type. DbUpdateException itself lives
         in the core Microsoft.EntityFrameworkCore assembly, not in .Abstractions. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
