# syntax=docker/dockerfile:1
#
# Never shipped. Exists only so scan-image-secrets.sh can prove Trivy's secret scan is
# actually capable of finding something, rather than passing vacuously (research.md R6).
#
# Trivy ships built-in *allow* rules for anything matching "example" (case-insensitive) or any
# path containing "test" — the canonical AKIAIOSFODNN7EXAMPLE dummy key and a bait file named
# "*test*" are both silently ignored. This bait deliberately avoids both: a freshly generated
# throwaway RSA private key (fires the built-in "private-key" HIGH rule with no allow-rule
# collision, and is regenerated at build time — never a tracked value) and a synthetic
# AWS_ACCESS_KEY_ID set as an image ENV, to exercise --image-config-scanners secret as well as
# the filesystem scan.
#
# secretbait.pem is generated fresh by infrastructure/scripts/scan-image-secrets.sh
# immediately before this image is built, and removed immediately after — it is never a
# tracked file (see .gitignore's blanket *.pem/*.key exclusion), only a build-context input
# that exists for the duration of one `docker build`.

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled AS bait

# Neither "example" nor "test" appears in this path, unlike the images/scripts this guards
# against silently passing.
ENV AWS_ACCESS_KEY_ID=AKIA0PENSESAME0BAITKEY0

USER root
# No RUN mkdir: a chiseled image has no shell, so RUN cannot execute at all — COPY creates
# any missing intermediate directories on its own.
COPY --chmod=0600 secretbait.pem /app/config/leak.pem
USER $APP_UID
